{
  "compilerOptions": {
    "target": "ES6",                         
    "module": "ESNext",                      
    "moduleResolution": "node",              
    "strict": true,                          
    "jsx": "react",                          
    "sourceMap": true,                       
    "outDir": "./dist",                      
    "baseUrl": "./src",                      
    "paths": {
      "@/*": ["./*"]
    },
    "esModuleInterop": true,                 
    "skipLibCheck": true                     
  },
  "include": ["src", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist"]
}